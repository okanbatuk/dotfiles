#!/usr/bin/zsh

# Interactive and workspace-aware pnpm wrapper script for Zsh
pm() {
  # Internal interactive confirmation prompt for root/recursive actions
  confirm_root_action() {
    local action_description="$1"
    local raw_cmd="$2"

    echo -e "\033[1;33m⚠️  SAFETY GUARD: Executing action at WORKSPACE ROOT\033[0m"
    echo -e "   Description : $action_description"
    echo -e "   Target Command : \033[1;36mpnpm $raw_cmd\033[0m"
    echo -n "   Do you want to proceed? [y/N]: "

    local choice
    read -r choice < /dev/tty
    case "$choice" in
      [yY]|[yY][eE][sS])
        return 0
        ;;
      *)
        echo -e "\033[1;31m❌ Operation canceled.\033[0m"
        return 1
        ;;
    esac
  }

  # Display help menu
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    echo -e "Usage: pm [action|target] [arguments]\n"
    echo -e "Options:"
    echo -e "  pm                            Interactive mode: Select workspace target and script via fzf"
    echo -e "  pm -h, --help                 Show this help message"
    echo -e "  pm build|test|lint|type       Run script across all workspace packages (pnpm -r <cmd>)"
    echo -e "  pm add|i [-D] <pkg>           Add dependency to workspace root (pnpm add -w [-D] <pkg>)"
    echo -e "  pm add|i                      Interactive dependency installation to a specific target"
    echo -e "  pm <target> add|i [-D] <pkg>  Add dependency to specific target (e.g. pm web i -D tailwindcss)"
    echo -e "  pm update|up <pkg>            Update specified package (pnpm update <pkg>)"
    echo -e "  pm exec|x <cmd>               Execute CLI binary at workspace root (pnpm exec <cmd>)"
    echo -e "  pm dlx <pkg>                  Execute package without installing (pnpm dlx <pkg>)"
    echo -e "  pm dev|start                  Interactively select a target and run script"
    echo -e "  pm <target> exec|x <cmd>      Execute CLI binary on specific target (e.g. pm web x sanity typegen generate)"
    echo -e "  pm <target> dlx <tool>        Run dlx on specific target (e.g. pm web dlx shadcn@latest add button)"
    echo -e "  pm <target> <cmd>             Run script on specific target (e.g. pm web dev -> pnpm --filter web dev)"
    return 0
  fi

  # 1. No arguments provided: Full interactive mode via fzf
  if [[ $# -eq 0 ]]; then
    local selected_target
    selected_target=$(pnpm ls -r --depth -1 --json 2>/dev/null | jq -r '.[].name' | fzf --header="1/2 - Select Workspace Target")

    [[ -z "$selected_target" ]] && return 0

    local script_cmd
    script_cmd=$(jq -r '.scripts | keys[]' "$(pnpm --filter "$selected_target" exec pwd)/package.json" 2>/dev/null | fzf --header="2/2 - Select Script ($selected_target)")

    if [[ -n "$script_cmd" ]]; then
      pnpm --filter "$selected_target" "$script_cmd"
    fi
    return 0
  fi

  local action="$1"
  shift

  case "$action" in
    # Run commands recursively across all workspace packages (-r)
    build|test|lint)
      pnpm -r "$action" "$@"
      ;;

    # Short alias for workspace typecheck
    type|typecheck)
      pnpm -r typecheck "$@"
      ;;

    # Root package installation handling
    add|i|install)
      if [[ $# -eq 0 ]]; then
        # Interactive mode when 'pm add' or 'pm i' is called without parameters
        local selected_target
        selected_target=$(pnpm ls -r --depth -1 --json 2>/dev/null | jq -r '.[].name' | fzf --header="Select target workspace package:")

        [[ -z "$selected_target" ]] && return 0

        echo -n "Enter package name (append -D for devDependency): "
        read -r new_dep < /dev/tty
        if [[ -n "$new_dep" ]]; then
          pnpm --filter "$selected_target" add ${=new_dep}
        fi
      else
        # 🛡️ INTERNAL GUARD: Prompt before adding dependencies to workspace ROOT
        confirm_root_action "Adding dependency to ROOT package.json" "add -w $*" || return 1
        pnpm add -w "$@"
      fi
      ;;

    # Update dependencies
    up|update)
      pnpm update "$@"
      ;;

    # Direct execution aliases at root
    x|exec)
      # 🛡️ INTERNAL GUARD: Prompt before executing binary at WORKSPACE ROOT
      confirm_root_action "Executing binary at WORKSPACE ROOT" "exec $*" || return 1
      pnpm exec "$@"
      ;;

    dlx)
      pnpm dlx "$@"
      ;;

    # Interactive dev/start script runner
    dev|start)
      local selected_target
      selected_target=$(pnpm ls -r --depth -1 --json 2>/dev/null | jq -r '.[].name' | fzf --header="Select target to run '$action':")
      [[ -n "$selected_target" ]] && pnpm --filter "$selected_target" "$action" "$@"
      ;;

    # Fallback: Treat first argument as target workspace package (e.g., 'pm web ...')
    *)
      if [[ $# -gt 0 ]]; then
        local sub_action="$1"
        shift
        case "$sub_action" in
          add|i|install)
            # Route: pm web i -D tailwindcss
            pnpm --filter "$action" add "$@"
            ;;
          exec|x)
            # Route: pm web x sanity typegen generate -> pnpm --filter web exec sanity typegen generate
            pnpm --filter "$action" exec "$@"
            ;;
          dlx)
            # Route: pm web dlx shadcn@latest add button -> pnpm --filter web dlx "$@"
            pnpm --filter "$action" dlx "$@"
            ;;
          *)
            pnpm --filter "$action" "$sub_action" "$@"
            ;;
        esac
      else
        pnpm "$action"
      fi
      ;;
  esac
}
