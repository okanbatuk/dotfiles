esp_hints() {
    # Path to your espanso hints file
    local HINTS_FILE="$HOME/dotfiles/hints/espanso_hints.txt"

    # Check if the file exists before proceeding
    [[ ! -f "$HINTS_FILE" ]] && { echo "Error: File not found"; return 1; }

    # Prepare data using awk:
    # 1:Category (Hidden), 2:Display Line, 3:Trigger, 4:Action, 5:Description, 6:CatName
    local data=$(awk -F '\t' '
        BEGIN { cat="General" }
        /^# ---/ {
            new_cat=$0;
            gsub(/^# --- | ---$/, "", new_cat);
            cat=new_cat;
            next
        }
        /^#/ || /^$/ { next }
        {
            # Output: HiddenCategory \t DisplayText \t Trigger \t Action \t Description \t CategoryName
            printf "%s\t- ⚡ %-10s ➔  %s\t%s\t%s\t%s\n", cat, $1, $2, $1, $2, $3
        }
    ' "$HINTS_FILE")

    # Save to a temporary file to avoid escaping issues and "argument list too long" errors
    local tmp_data="/tmp/esp_hints_data"
    echo "$data" > "$tmp_data"

    local selected=$(cat "$tmp_data" | fzf --height 70% \
        --reverse \
        --header "🔍 CTRL-G: Category Mode | CTRL-A: All Fields | ESC: Reset" \
        --prompt="Search All > " \
        --border --ansi --tabstop=15 --delimiter $'\t' \
        --preview-window 'right:45%:border-left' \
        --with-nth 2 \
        --disabled \
        --bind "start:reload(cat $tmp_data)" \
        --bind "change:reload(rg --smart-case {q} $tmp_data || true)" \
        --bind "ctrl-g:change-prompt(Category > )+reload(awk -F '\t' -v q='{q}' 'IGNORECASE=1; \$1 ~ q' $tmp_data)" \
        --bind "ctrl-a:change-prompt(Search All > )+reload(rg --smart-case {q} $tmp_data || true)" \
        --preview '
            # Extracting variables from the tab-separated input
            p_cat=$(echo {1} | tr -d "[:cntrl:]")
            p_trigger=$(echo {3} | sed "s/^\x27//; s/\x27$//")
            p_action=$(echo {4} | sed "s/^[[:space:]]*//;s/[[:space:]]*$//; s/^\x27//; s/\x27$//")
            p_desc=$(echo {5} | sed "s/^[[:space:]]*//;s/[[:space:]]*$//")

            # Preview Panel UI
            echo -e "\n  \033[1;35m📁 Category\033[0m"
            echo -e "  \033[1;37m[$p_cat]\033[0m"

            echo -e "\n  \033[1;34m󰘳 Trigger\033[0m"
            echo -e "  \033[1;37m<:$p_trigger>\033[0m"

            echo -e "\n  \033[1;32m󱔗 Action\033[0m"
            echo -e "  \033[0;37m$p_action\033[0m"

            echo -e "\n  \033[1;33m󰛨 Description\033[0m"
            echo -e "  \033[0;37m$p_desc\033[0m"
        ')

    # Cleanup temporary file
    rm -f "$tmp_data"

    # Process final selection output
    if [[ -n "$selected" ]]; then
        local out_trigger=$(echo "$selected" | cut -f3 | sed "s/^[[:space:]]*//;s/[[:space:]]*$//; s/^\x27//; s/\x27$//")
        local out_action=$(echo "$selected" | cut -f4 | sed "s/^[[:space:]]*//;s/[[:space:]]*$//; s/^\x27//; s/\x27$//")
        echo "- ⚡$out_trigger ➔ $out_action"
    fi
}
