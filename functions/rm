# ------------------------------------------------------------------------------
# Safe 'rm' Wrapper: Strips both standalone '-f' and combined flags like '-rf'
# to force interactivity in the current shell.
# ------------------------------------------------------------------------------
function rm() {
    local args=()

    # 1. Logic to strip force flags and enforce interaction
    for arg in "$@"; do
        if [[ "$arg" != "-f" ]] && [[ "$arg" != "--force" ]]; then
            # Remove 'f' from flag (e.g., -rf becomes -r, -f becomes -)
            # Then remove the trailing '-' if it's left alone
            args+=("$arg")
        fi
    done

    # 2. Add safe flags for interactive use
    # Using --preserve-root as a baseline safety measure
    local safe_args=("--preserve-root" "--interactive=once" "${args[@]}")

    # 3. Security Layer: Pass execution to guard.sh instead of 'command rm'
    # This ensures that if run as root, blacklist (e.g., rm -rf /) is checked.
    bash "$HOME/scripts/.guard.sh" rm "$@"
}
