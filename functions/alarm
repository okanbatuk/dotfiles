# Location: ~/dotfiles/functions/alarm
# Purpose: Professional CLI tool for high-precision systemd timers

function alarm() {
    # Color definitions using raw ANSI codes for maximum independence
    local C_BLUE='\033[1;34m'
    local C_GREEN='\033[1;32m'
    local C_RED='\033[1;31m'
    local C_NC='\033[0m' # No Color

    # Default internal values
    local opt_time="15m"
    local opt_msg=""
    local opt_list=0
    local opt_help=0

    # Advanced flag parsing using zparseopts for dual-interface (-t / --time)
    zparseopts -D -E \
        t:=opt_time -time:=opt_time \
        m:=opt_msg -message:=opt_msg \
        l=opt_list -list=opt_list \
        h=opt_help -help=opt_help

    # Standardized help menu
    local usage="Usage: alarm [options] [message]

Options:
  -t, --time <dur>     Time duration (e.g., 5s, 10m, 1h). Default: 15m
  -m, --message <msg>  Alarm message (Can also be passed as last argument)
  -l, --list           List active alarms (Sorted by proximity)
  -h, --help           Show this help message"

    if [[ -n "$opt_help" ]]; then
        echo "$usage"
        return 0
    fi

    # --- Active Alarms Listing Logic ---
    if [[ -n "$opt_list" ]]; then
        echo -e "${C_BLUE}#   TRIGGER TIME          MESSAGE${C_NC}"
        echo -e "------------------------------------------------------------"

        local count=1
        # Fetch active alarm timers and sort manually by timestamp
        systemctl --user list-timers "alarm-*" --no-legend | sort -k1,2 | while read -r line; do
            [[ -z "$line" ]] && continue
            local next_run=$(echo "$line" | awk '{print $1" "$2" "$3}')
            local unit=$(echo "$line" | awk '{print $NF}')
            local desc=$(systemctl --user show "$unit" --property=Description --value | sed 's/Alarm: //')
            printf "${C_GREEN}%-3s${C_NC} %-20s %s\n" "$count." "$next_run" "$desc"
            ((count++))
        done
        [[ $count -eq 1 ]] && echo "No active alarms found."
        return 0
    fi

    # --- Core Execution Logic ---
    # Extract time value from array
    local val_time=${opt_time[-1]:-$opt_time}

    # Smart Message Handling: Use -m flag, or fallback to leftover arguments, or default
    local flag_msg=${opt_msg[-1]}
    local leftover_msg="$*"
    local final_msg="${flag_msg:-${leftover_msg:-General Reminder}}"

    # Generate unique unit name and resolve script path
    local alarm_id=$(date +%s)
    local unit_name="alarm-${alarm_id}"
    local script_path="$HOME/scripts/.alarm-notify.sh"

    # Deploy transient systemd timer with high accuracy
    if systemd-run --user \
        --unit="$unit_name" \
        --description="Alarm: $final_msg" \
        --timer-property="OnActiveSec=${val_time}" \
        --timer-property="AccuracySec=1ms" \
        --property="KillMode=process" \
        --collect \
        "$script_path" "$final_msg" 2>/dev/null; then
        echo -e "${C_GREEN}✅ Alarm set:${C_NC} '$final_msg' in $val_time."
    else
        echo -e "${C_RED}❌ Error:${C_NC} Invalid time format '$val_time'. Use 5s, 10m, 1h etc."
        return 1
    fi
}
