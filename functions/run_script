# ------------------------------------------------------------------------------
# Script Dispatcher & Wrapper Functions
# Purpose: Resolves $SCRIPTS_DIR dynamically and ensures correct syntax highlighting.
# ------------------------------------------------------------------------------

# Central dispatcher to execute scripts from the scripts directory
function _run_script() {
    local script_name="$1"
    shift # Remove the script name from arguments, keep the rest for the script

    local script_path="$SCRIPTS_DIR/$script_name"

    # Check if script exists and is executable
    if [[ -f "$script_path" ]]; then
        "$script_path" "$@"
    else
        echo -e "\033[1;31m❌ Error:\033[0m Script not found at $script_path"
        return 1
    fi
}

# --- ⚡ Fast Execution Wrappers (Static parameters) ---

# Shutdown with confirmation
sd() { _run_script ".shutdown.sh" }
sdy() { _run_script ".shutdown.sh" "y" }
sdn() { _run_script ".shutdown.sh" "n" }

# Disk Management
dmount() { _run_script ".mount.sh" }
dreport() { _run_script ".disk-report.sh" }

# System updates and informations
up()  { _run_script ".update.sh" "--light" }
upf() { _run_script ".update.sh" "--full" }
get-info() { _run_script ".get-info.sh" "$@" }
