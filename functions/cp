# ------------------------------------------------------------------------------
# Safe Copy Wrapper: Prevents accidental file overwrites by prompting for
# confirmation when the target destination already exists.
# ------------------------------------------------------------------------------
cp() {
    # The last argument is typically the target destination
    local target="${@: -1}"

    # If the target is an existing file, prompt for overwrite
    if [[ -f "$target" ]]; then
        echo -e "\033[0;33m[Guardian]\033[0m Target file '\033[1;31m$target\033[0m' already exists."
        echo -ne "           Overwrite? (y/N): "
        read confirm
        # If input is not exactly 'y' or 'Y', abort the operation
        [[ "$confirm" != [yY] ]] && { echo "Copy aborted."; return 1; }
    fi

    # Use -i as a secondary fallback and execute
    command cp -i "$@"
}
