# --- Git Destructive & Force Operations ---
git reset --hard#Irreversible: Overwrites all local changes and matches the remote HEAD.
git rebase -i#Risk: Rewrites commit history; can cause complex conflicts in shared branches.
git clean -fd#Danger: Permanently removes untracked files and directories from your workspace.
git push --force-with-lease#Critical: Overwrites remote history with lease validation.
git push --force#Critical: Overwrites remote history. Potential to delete colleagues work.
git push --all#Critical: Pushes all local branches to remote, potentially overwriting shared work.
git branch -D#Danger: Force-deletes local branches even if they contain unmerged changes.
git stash drop#Data Loss: Discards stashed changes permanently without applying them.

# --- System High-Risk & Permissions ---
chmod -R#Recursive permissions: Can break system security or render services unreadable.
chown -R#Recursive ownership: Can lock you out of your own files or break system daemons.
rm -rf#The Nuke: Permanently deletes files and folders without moving to trash.
mv /#Critical: Moving system root or top-level dirs will cause immediate system failure.
shred#Security: Overwrites file data multiple times; absolutely impossible to recover.
mkfs#Critical: Formats a storage device, causing immediate and permanent data loss.
dd if=#Critical: Low-level disk writing tool; risk of overwriting entire partitions or boot sectors.

# --- Docker & Database Destruction ---
docker system prune#Cleanup: Deletes all stopped containers, unused networks, and dangling images.
docker volume rm#Data Loss: Permanently deletes persistent data stored in Docker volumes.
docker-compose down -v#Cleanup: Stops containers and removes all associated volumes (data loss).
dropdb#Database: Permanently deletes the specified database and all its tables.

# --- System Services, Network & Process Management ---
sudo ufw disable#Firewall: Disabling UFW exposes your system to direct network attacks.
ufw reset#Firewall: Resets all firewall rules, clearing custom security configurations.
iptables -F#Firewall: Flushes all firewall chains, removing network packet filters.
systemctl stop#Service Stop: Stopping critical systemd units can hang the OS or crash apps.
sudo usbguard block-device#Hardware: Disables hardware interface or security device via kernel module or system toggle.
sudo systemctl stop bluetooth#Hardware: Disables Bluetooth stack; will disconnect all wireless peripherals.
killall -9#Process Kill: Forcefully terminates all processes matching a specified name.
