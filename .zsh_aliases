# ~/.zsh_aliases - Command shortcuts and security wrappers

# --- 🛡️ Guardian & Security Controls ---
# 'sudo ' with a space allows alias expansion for the next command
alias sudo="sudo "

# --- 📦 Package Manager Guards (Avoid Root Pollution) ---
alias npm="$SCRIPTS_DIR/.guard.sh npm"
alias pnpm="$SCRIPTS_DIR/.guard.sh pnpm"
alias yarn="$SCRIPTS_DIR/.guard.sh yarn"
alias bun="$SCRIPTS_DIR/.guard.sh bun"
alias cargo="$SCRIPTS_DIR/.guard.sh cargo"
alias pip="$SCRIPTS_DIR/.guard.sh pip"
alias gem="$SCRIPTS_DIR/.guard.sh gem"

# --- 🚀 App Launchers (Wayland Optimized) ---
alias windsurf='windsurf --ozone-platform=wayland'
alias code='code --ozone-platform=wayland'

# --- 🔐 Security & Hardware Control --- (Webcam & Bluetooth & Fingerprint Sensor)
alias cam-off='sudo usbguard block-device id "$ID_WEBCAM"'
alias cam-on='sudo usbguard allow-device id "$ID_WEBCAM"'
alias bt-off='sudo systemctl stop bluetooth && sudo usbguard block-device id $ID_BLUETOOTH'

alias bt-on='sudo usbguard allow-device id $ID_BLUETOOTH && sudo systemctl start bluetooth'
alias fp-off='sudo usbguard block-device id $ID_FINGERPRINT'
alias fp-on='sudo usbguard allow-device id $ID_FINGERPRINT'

# --- ⚙️ System Maintenance & Dotfiles ---
alias upfull="$SCRIPTS_DIR/.update.sh --full"
alias up="$SCRIPTS_DIR/.update.sh --light"
alias sd="$SCRIPTS_DIR/.shutdown.sh"
alias sdy="$SCRIPTS_DIR/.shutdown.sh y"
alias sdn="$SCRIPTS_DIR/.shutdown.sh n"
alias dmount="$SCRIPTS_DIR/.mount.sh"
alias dreport="$SCRIPTS_DIR/.disk-report.sh"
alias get-info="$SCRIPTS_DIR/.get-info.sh"
alias reload='source ~/.zshrc'
alias psr='gnome-extensions disable pop-shell@system76.com && gnome-extensions enable pop-shell@system76.com'

# --- 🎨 Modern CLI Replacements (Eza & Bat) ---
alias cat='bat --paging=never'
alias less='bat'
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -al --icons=auto --git'
alias free='free -m -h'
alias df='duf'
alias fo='fd --type f | fzf --preview "bat --color=always --style=numbers --line-range :500 {}" | xargs -r handlr open'

# --- 🔍 Search & Filter ---
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# --- 🚀 Navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# --- ⚙️ Fast Config Access ---
alias zshconf="nvim ~/.zshrc"
alias aliasconf="nvim ~/.zsh_aliases"
alias espconf="nvim $DOTFILES_DIR/config/espanso/match/base.yml"

# --- 🛠️ Git Quick Access ---
alias gs='git status'
alias gd='git diff'
alias gp='git push'
alias gpl='git pull'
alias gl='git log --oneline --graph --all'
alias gac='git add . && git commit -m'
alias gcan='git commit --amend --no-edit' # Quick fix for last commit
alias gacan='git add . && git commit --amend --no-edit' # Add all and amend
alias gco='git checkout'
alias gcb='git checkout -b' # Create and switch to new branch
alias gb='git branch'
alias grs='git restore --staged' # Unstage files
alias gclean='git fetch --prune && git branch -vv | grep ": gone]" | awk "{print \$1}" | xargs -r git branch -d' # Cleanup merged branches

# --- 🌐 Network ---
alias myip='curl ifconfig.me'
