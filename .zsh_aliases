alias windsurf='windsurf --ozone-platform=wayland'
alias code='code --ozone-platform=wayland'
alias upfull="$HOME/dotfiles/scripts/.update.sh --full"
alias up="$HOME/dotfiles/scripts/.update.sh --light"
alias cam-off='sudo usbguard block-device id 04f2:b5a7'
alias cam-on='sudo usbguard allow-device id 04f2:b5a7'
alias shut="$HOME/dotfiles/scripts/.shutdown.sh"
alias disk-mount="$HOME/dotfiles/scripts/.mount.sh"
alias disk-report="$HOME/dotfiles/scripts/.disk-report.sh"
alias get-info='~/dotfiles/scripts/.get-info.sh'

# 🎨 Colorful aliases for common commands
# alias ls='ls --color=auto'
alias cat='bat --paging=never'
alias less='bat'
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -al --icons=auto --git'
alias tree='eza --tree --level=2 --icons=auto'
alias grep='grep --colour=auto'
alias egrep='egrep --colour=auto'
alias fgrep='fgrep --colour=auto'

