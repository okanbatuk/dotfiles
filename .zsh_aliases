# 🚀 App Launchers (Wayland Optimized)
alias windsurf='windsurf --ozone-platform=wayland'
alias code='code --ozone-platform=wayland'

# 🔐 Security & Hardware Control
alias cam-off='sudo usbguard block-device id 04f2:b5a7'
alias cam-on='sudo usbguard allow-device id 04f2:b5a7'

# ⚙️ Dotfiles & System Maintenance
alias upfull="$HOME/scripts/.update.sh --full"
alias up="$HOME/scripts/.update.sh --light"
alias shut="$HOME/scripts/.shutdown.sh"
alias disk-mount="$HOME/scripts/.mount.sh"
alias disk-report="$HOME/scripts/.disk-report.sh"
alias get-info="$HOME/scripts/.get-info.sh"
alias reload='source ~/.zshrc'

# 🧩 GNOME & Pop Shell Fixes (Reset Tiling Mode)
alias psr='gnome-extensions disable pop-shell@system76.com && gnome-extensions enable pop-shell@system76.com'

# 🎨 Modern CLI Replacements (Eza & Bat)
alias cat='bat --paging=never'
alias less='bat'
alias ls='eza --group-directories-first --icons=auto'
alias ll='eza -al --icons=auto --git'
alias free='free -m -h'
alias df='duf'
alias o='handlr open'
alias fo='fd --type f | fzf --preview "bat --color=always --style=numbers --line-range :500 {}" | xargs -r handlr open'

# 🔍 Grep Enhancements
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# 🚀 Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# ⚙️ Fast Config Access
alias zshconf="nvim ~/.zshrc"
alias aliasconf="nvim ~/.zsh_aliases"
alias espconf="nvim ~/dotfiles/config/espanso/match/base.yml"

# 🛠️ Git Quick Access
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --graph --all'
alias gac='git add . && git commit -m'

# 🌐 Network
alias myip='curl ifconfig.me'
