# ~/.zsh_aliases - Command shortcuts and security wrappers

# --- 🛡️ Guardian & Security Controls ---
alias sudo='sudo ' # Allow aliases to be sudo-ed

# --- 📦 Package Manager Guards (Avoid Root Pollution) ---
alias npm='$SCRIPTS_DIR/.guard.sh npm' # Guard npm against root pollution
alias pnpm='$SCRIPTS_DIR/.guard.sh pnpm' # Guard pnpm against root pollution
alias yarn='$SCRIPTS_DIR/.guard.sh yarn' # Guard yarn against root pollution
alias bun='$SCRIPTS_DIR/.guard.sh bun' # Guard bun against root pollution
alias cargo='$SCRIPTS_DIR/.guard.sh cargo' # Guard cargo against root pollution
alias pip='$SCRIPTS_DIR/.guard.sh pip' # Guard pip against root pollution
alias gem='$SCRIPTS_DIR/.guard.sh gem' # Guard gem against root pollution

# --- 📂 Navigation & Listing & Search 🔍 ---
alias ..='cd ..' # Go up one 
alias ...='cd ../..' # Go up two 
alias .3='cd ../../..' # Go up three 
alias c='clear' # Clear  screen
alias f='rg --smart-case' # Fast search with ripgrep 🔍
alias l='eza -lh --icons --group-directories-first' # List files (Detailed) 📄
alias ls='eza --icons --group-directories-first' # List files (Short) 📄
alias ll='eza -lha --icons --group-directories-first --git' # List all files with Git status 📄
alias tree='eza --tree --icons' # Display directory tree 
alias cat='bat --paging=never' # Read file (Modern cat)
alias less='bat' # Paginated file reader (Modern less)
alias grep='grep --color=auto --exclude-dir={.git,node_modules,vendor}' # Global regular expression print 🔍
alias egrep='grep -E --color=auto' # Extended grep 🔍
alias fgrep='grep -F --color=auto' # Fixed grep (No regex) 🔍
alias search='rg --smart-case --stats' # Detailed search with statistics 📊
alias h='history | fzf' # Search command history with fzf 
alias p='cd $(fd -t d | fzf)' # Interactive directory jumper with fzf 
alias v='nvim $(fd -t f | fzf)' # Find and open file in Neovim with fzf 
alias fo='fd --type f | fzf | xargs -r handlr open' # Find and open file with fzf 

# --- 📂 File & Directory Operations ---
alias cmx='chmod +x' # Make file executable
alias big='du -ah . | sort -rh | head -n' # List top X largest files in current dir
alias dir='du -sh */ | sort -rh' # List directories sorted by size
alias ds1='dust -d 1' # Disk usage summary (depth 1)
alias ds2='dust -d 2' # Disk usage summary (depth 2)
alias ft='fulltree' # Display full directory tree
alias pt='projtree' # Display project-specific tree
alias findf='find . -type f -name' # Find files by name (Usage: findf "*name*")
alias findd='find . -type d -name' # Find directories by name
alias fdf='fd -t f' # Fast find files
alias fdd='fd -t d' # Fast find directories
alias fda='fd -IH' # Fast find all (including hidden/ignored)

# --- 📦 Compression & Archiving ---
alias tarc='tar -czvf' # Create a compressed tar.gz archive
alias tarx='tar -xzvf' # Extract a tar.gz archive
alias zipr='zip -r' # Create a recursive zip archive

# --- 🖥️ Disk, Memory & System Info ---
alias disk='df -h' # Show disk space usage in human-readable format
alias mem='free -h' # Show memory usage in human-readable format
alias top='htop' # Interactive process viewer (Modern top)
alias get-info='$SCRIPTS_DIR/.get-info.sh' # System hardware/OS summary
alias di='get-info --full' # Detailed hardware/OS info
alias si='get-info' # Standard hardware/OS info
alias li='get-info --light' # Minimal hardware/OS info
alias size='du -sh' # Show size of a specific file or directory
alias jlog-size='journalctl --disk-usage' # Show systemd journal disk usage
alias curlj='curl -s' # Silent curl for scripts or clean output
alias get-timers='systemctl list-timers --all' # List all active systemd timers
alias ul='sudo usbguard list-devices' # List USB devices (Security)
alias ua='sudo usbguard allow-device' # Allow a specific USB device

# --- ⚙️ System Maintenance ---
alias upfull='$SCRIPTS_DIR/.update.sh --full' # Full system maintenance (Weekly)
alias up='$SCRIPTS_DIR/.update.sh --light' # Light system update
alias sd='$SCRIPTS_DIR/.shutdown.sh' # Safe system cleanup and shutdown 🧹
alias sdy='$SCRIPTS_DIR/.shutdown.sh y' # Safe shutdown with cleaning 🧹
alias sdn='$SCRIPTS_DIR/.shutdown.sh n' # Safe clean (No shutdown) 🧹
alias dmount='$SCRIPTS_DIR/.mount.sh' # Mount defined drives
alias dreport='$SCRIPTS_DIR/.disk-report.sh' # Generate disk usage report
alias sys-err='journalctl -p 3 -xb' # Show high priority system errors 🚨
alias free='free -m -h' # Show RAM usage (Human readable)
alias df='duf' # Show disk usage (Modern df)
alias tfa='2fa' # Generate 2FA tokens
alias psr='gnome-extensions disable pop-shell@system76.com && gnome-extensions enable pop-shell@system76.com' # Restart Pop Shell extension

# --- 📦 Package Manager & System ---
alias pac='sudo pacman -Syu' # Update system (Pacman)
alias psearch='pacman -Ss' # Search for packages 🔍
alias orp='pacman -Qdt' # List orphan packages
alias mirrors='sudo pacman-mirrors --fasttrack 10 && sudo pacman -Syyu' # Update mirrors and sync
alias y='yay -Sua' # Update AUR packages
alias temp='watch sensors' # Monitor hardware temperatures
alias sstat='systemctl status' # Check systemd service status
alias ss='sudo systemctl start' # Start systemd service ▶️
alias sstop='sudo systemctl stop' # Stop systemd service 🛑
alias sr='sudo systemctl restart' # Restart systemd service
alias sl='sudo journalctl -u' # View service logs (journalctl)

# ---  Hardware Control ---
alias cam-off='sudo usbguard block-device id "$ID_WEBCAM"' # Disable Webcam
alias cam-on='sudo usbguard allow-device id "$ID_WEBCAM"' # Enable Webcam
alias bt-off='sudo systemctl stop bluetooth' # Stop Bluetooth service 🛑
alias bt-on='sudo systemctl start bluetooth' # Start Bluetooth service
alias fp-off='sudo usbguard block-device id $ID_FINGERPRINT' # Disable Fingerprint
alias fp-on='sudo usbguard allow-device id $ID_FINGERPRINT' # Enable Fingerprint

# ---  Development Tools ---
alias n='nvim' # Open Neovim 
alias v='nvim' # Open Neovim   (shortcut)
alias zed='zeditor' # Open Zed Editor
alias code='code --ozone-platform=wayland' # Open VS Code (Wayland)
alias windsurf='windsurf --ozone-platform=wayland' # Open Windsurf IDE
alias ff='fastfetch' # System information fetch 🚀
alias alsa='alsamixer' # Open Alsamixer
alias dps='docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}"' # List running Docker containers

# ---  Git Operations ---
alias gs='git status' # Git  status
alias gd='git diff' # Git  diff
alias gdc='git diff --cached' # Git  diff i/ cached
alias gp='git push' # Git  push
alias gpf='git push --force-with-lease' # Git  push w/ safe-force
alias gpl='git pull' # Git  pull
alias gl='git log --oneline --graph --all' # Visual Git  log graph 📊
alias gc='git commit -m' # Git  commit w/ message
alias ga='git add' # Git  add
alias gac='git add . && git commit -m' # Git  add all and commit
alias gcan='git commit --amend --no-edit' # Amend last commit (no edit)
alias gcanp='git commit --amend --no-edit && gpf' # Amend last commit (no edit)
alias gacan='git add . && git commit --amend --no-edit' # Git  Add all and amend last commit
alias gclean='git fetch --prune && git branch -vv | grep ": gone]" | awk "{print \$1}" | xargs -r git branch -d' # Git  Delete merged/gone branches
alias gco='git checkout' # Switch branch or restore files
alias gcb='git checkout -b' # Create and switch to new branch
alias gb='git branch' # List local branches
alias grs='git restore --staged' # Unstage files
alias gundo='git reset --soft HEAD~1' # Git  Undo last commit (keep changes)
alias gam='git commit --amend -m' # Git  Amend last commit with new message
alias gcln='git branch --merged | grep -v "\*" | xargs -n 1 git branch -d' # Git  Clean merged local branches
alias gup='git remote update && git status -uno' # Git  Update remote tracking and show status
alias gpo='git pull origin $(git branch --show-current)' # Git  Pull from origin [current branch]
alias gstash='git stash push -m' # Git  Stash changes with message
alias gsp='git stash pop' # Git  Pop last stash
alias gtag='git tag' # Git  Create a new tag
alias gfetch='git fetch --prune' # Git  Fetch and prune deleted remote branches
alias greb='git rebase -i HEAD~' # Git  Interactive rebase (specify number)

# --- 🐳 Docker Ops ---
alias dr='docker run' # Run a new docker 🐳 container
alias ds='docker stop' # Stop a running container 🛑
alias dstop='docker stop $(docker ps -q)' # Stop all running containers 🛑
alias dlogs='docker logs -f' # Follow container logs
alias dstats='docker stats' # Show container resource usage
alias dclean='docker system prune -af --volumes' # Nuke all unused docker data
alias dbuild='docker build -t' # Build image from Dockerfile
alias drmi='docker rmi $(docker images -q -f "dangling=true")' # Remove dangling images 🧹
alias dc='docker-compose' # Docker-compose wrapper

# --- 🐳 Docker Lab (dlab) ---
alias dlup='dlab -ub -n' # Start lab service with rebuild
alias dls='dlab -s -n' # Stop lab containers
alias dlt='dlab -t -n' # Full teardown (images, volumes)
alias dlr='dlab -r -n' # Reset: Teardown + rebuild
alias dlp='dlab -p' # Show container status
alias dlx='dlab -x -n' # Exec into container (as root)
alias dll='dlab -l -n' # Follow service logs

# --- ⎈ Kubernetes (k8s) ---
alias kaf='kubectl apply -f' # K8s  Apply configuration from file
alias kgn='kubectl get nodes' # K8s  List all nodes
alias kgp='kubectl get pods' # K8s  List all pods
alias kgs='kubectl get svc' # K8s  List all services
alias kdp='kubectl describe pod' # K8s  Describe a specific pod
alias kl='kubectl logs -f' # K8s  Follow pod logs

# ---  Node & Backend ---
alias nr='npm run' # NPM run command
alias br='bun run' # Bun run command
alias ni='npm install' # NPM install
alias nid='npm install -D' # NPM install dev dependencies
alias bi='bun install' # Synchronize and install project dependencies from lockfile
alias bci='bun install --frozen-lockfile' # Clean install with strict lockfile verification
alias ba='bun add' # Add a new runtime dependency to package.json
alias bad='bun add -d' # Add a new development-only dependency to package.json
alias nuke='rm -rf node_modules' # Nuke node_modules folder ☢️
alias venv='python3 -m venv venv && source venv/bin/activate' # Create/Activate venv
alias pyv='python3 --version' # Show Python version
alias pi='pip install' # Install python package 🐍
alias pyact='source venv/bin/activate' # Activate python virtual environment 🐍
alias pf='pip freeze > requirements.txt' # Freeze python dependencies 🧊

# --- 🔧 Fast Config Access ---
alias zshconf='nvim ~/.zshrc' # Edit .zshrc
alias aliasconf='nvim ~/.zsh_aliases' # Edit .zsh_aliases
alias espconf='nvim $DOTFILES_DIR/config/espanso/match/base.yml' # Edit Espanso config
alias reload='source ~/.zshrc' # Reload Zsh configuration
alias res='reload' # Reload Zsh configuration
alias e='exit'

# --- 🔍 Search & Hints (Quick Access) ---
alias ah='als_hints' # Search terminal aliases
alias eh='esp_hints' # Search Espanso triggers
alias zh='zen_hints' # Search Zen Browser shortcuts

# --- ⚡ Espanso Management ---
alias esps='espanso start' # Start Espanso service ▶️
alias espr='espanso restart' # Restart Espanso service

# --- 🔄 Syncthing Management ---
alias sync-on='systemctl --user start syncthing.service && echo " Syncthing is STARTING..."' # Start Syncthing service
alias sync-off='systemctl --user stop syncthing.service && echo " Syncthing is STOPPED."' # Stop Syncthing service
alias sync-stat='systemctl --user status syncthing.service' # Check Syncthing status
alias sync-web='o http://localhost:8384' # Open Syncthing Web UI
alias son='sync-on' # Start Syncthing service
alias soff='sync-off' # Stop Syncthing service
alias sweb='sync-web' # Open Syncthing Web UI
alias ssync='sync-stat' # Check Syncthing status

# --- 🌐 Network & Security ---
alias fw='sudo ufw status' # Check Firewall status
alias fwa='sudo ufw allow' # Allow port through Firewall
alias fwe='sudo ufw enable' # Enable Firewall
alias fwd='sudo ufw disable' # Disable Firewall
alias fbs='sudo fail2ban-client status' # Check Fail2Ban status
alias pingg='ping 8.8.8.8' # Ping Google DNS (Network check)
alias http='python3 -m http.server 8000' # Start instant HTTP server
alias myip='curl -s https://ipinfo.io/ip' # Show public IP
alias vpath='echo $PATH | tr ":" "\n"' # Readable PATH variable
