# ~/.zsh_functions

# Advanced Espanso Search: Search in both triggers and replacements
# Uses fzf to interactively find espanso triggers
matches() {
    local MATCH_FILE="$HOME/dotfiles/config/espanso/match/base.yml"
    
    if [[ -f "$MATCH_FILE" ]]; then
        # 1. First, convert the YAML file into a clean list
        # 2. Use fzf to search within both triggers and replacements
        grep -E 'trigger:|replace:' "$MATCH_FILE" | \
        sed 's/^[[:space:]]*//' | \
        # Join trigger and replace lines together (similar to paste command)
        sed 'N;s/\n/ /' | \
        # Format the output for a cleaner look in fzf
        sed 's/trigger: ":/󱐋 /; s/replace: / ➔ /; s/"//g' | \
        fzf --height 40% \
            --reverse \
            --header "Search by trigger or content (e.g., 'git commit')" \
            --border \
            --ansi
    else
        echo "Espanso base.yml not found at $MATCH_FILE"
    fi
}

# Open PDF with Zathura in background silently
pdf() {
    if [[ -n "$1" ]]; then
        # Run zathura, redirect output to null, and run in background
        zathura "$1" > /dev/null 2>&1 &
        # Ensure the process continues if the terminal is closed
        disown
    else
        echo "Usage: pdf file.pdf"
    fi
}

# Project Tree: Modern listing with eza, ignoring common heavy directories
# Usage: projtree [-p path] [-d depth] [-i ignore1] [-i ignore2] [-h]
projtree() {
  local target_path="."
  local depth=2
  local additional_ignore=""
  local OPTIND opt

  # First pass to capture target_path for intelligent path stripping
  while getopts "p:d:i:h" opt; do
    case "$opt" in
      p) target_path=$OPTARG ;;
    esac
  done

  # Reset index for the second pass
  OPTIND=1

  while getopts "p:d:i:h" opt; do
    case "$opt" in
      p) target_path=$OPTARG ;;
      d) depth=$OPTARG ;;
      i) 
        local clean_val=$OPTARG
        local base_p=${target_path%/}

        # Automatically strip the target path prefix and trailing slash for tab-completion compatibility
        clean_val=${clean_val#$base_p/} 
        clean_val=${clean_val%/}

        if [[ -z "$additional_ignore" ]]; then
          additional_ignore="$clean_val"
        else
          additional_ignore="$additional_ignore|$clean_val"
        fi
        ;;
      h) 
        echo "Usage: projtree [OPTIONS]"
        echo "  -p <path>   Target directory (default: .)"
        echo "  -d <depth>  Tree depth (default: 2)"
        echo "  -i <glob>   Ignore pattern (auto-strips path prefix, can be used multiple times)"
        echo "  -h          Show this help message"
        return 0
        ;;
      *) return 1 ;;
    esac
  done

  local final_ignore="node_modules|dist|.git"
  if [[ -n "$additional_ignore" ]]; then
    final_ignore="$final_ignore|$additional_ignore"
  fi

  command eza --tree -a --level="$depth" --icons=auto --ignore-glob="$final_ignore" "$target_path"
}

# Full Tree: Modern listing with eza, showing everything with optional ignore
# Usage: fulltree [-p path] [-d depth] [-i ignore1] [-i ignore2] [-h]
fulltree() {
  local target_path="."
  local depth=2
  local ignore_pattern=""
  local OPTIND opt

  # First pass to capture target_path for intelligent path stripping
  while getopts "p:d:i:h" opt; do
    case "$opt" in
      p) target_path=$OPTARG ;;
    esac
  done

  # Reset index for the second pass
  OPTIND=1

  while getopts "p:d:i:h" opt; do
    case "$opt" in
      p) target_path=$OPTARG ;;
      d) depth=$OPTARG ;;
      i) 
        local clean_val=$OPTARG
        local base_p=${target_path%/}
        # Strip path prefix to ensure eza's ignore-glob matches correctly even with tab-completion
        clean_val=${clean_val#$base_p/} 
        clean_val=${clean_val%/}

        if [[ -z "$ignore_pattern" ]]; then
          ignore_pattern="$clean_val"
        else
          ignore_pattern="$ignore_pattern|$clean_val"
        fi
        ;;
      h)
        echo "Usage: fulltree [OPTIONS]"
        echo "  -p <path>   Target directory (default: .)"
        echo "  -d <depth>  Tree depth (default: 2)"
        echo "  -i <glob>   Ignore pattern (auto-strips path prefix, can be used multiple times)"
        echo "  -h          Show this help message"
        return 0
        ;;
      *) return 1 ;;
    esac
  done

  if [[ -n "$ignore_pattern" ]]; then
    command eza --tree -a --level="$depth" --icons=auto --ignore-glob="$ignore_pattern" "$target_path"
  else
    command eza --tree -a --level="$depth" --icons=auto "$target_path"
  fi
}

# --- Zsh Completion Support ---
# This ensures that 'Tab' key works for flags like -p and -i for both functions
_tree_functions_completion() {
    _arguments \
        '-p[Target path]:directory:_files -/' \
        '-d[Tree depth]:depth:' \
        '-i[Ignore pattern]:ignore:_files' \
        '-h[Show help]'
}

compdef _tree_functions_completion projtree
compdef _tree_functions_completion fulltree
