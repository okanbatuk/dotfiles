" --- INTERNAL PLUGINS & SETTINGS ---
set surround
set multiple-cursors
set commentary
set argtextobj
set easymotion
set hlsearch
set ic



" --- SPLIT & PANE MANAGEMENT ---
nnoremap <C-A-S-l> :action SplitVertically<CR>
nnoremap <C-A-S-j> :action SplitHorizontally<CR>
nnoremap <C-A-a>h <C-w>h
nnoremap <C-A-a>j <C-w>j
nnoremap <C-A-a>k <C-w>k
nnoremap <C-A-a>l <C-w>l
" Toggle Docks
nnoremap <C-w>l :action ActivateRightToolWindow<CR>
nnoremap <C-w>h :action ActivateLeftToolWindow<CR>
nnoremap <C-w>j :action ActivateBottomToolWindow<CR>

" --- NAVIGATION (g commands) ---
nnoremap gd :action GotoImplementation<CR>
nnoremap gD :action GotoDeclaration<CR>
nnoremap gy :action GotoTypeDeclaration<CR>
nnoremap gi :action GotoImplementation<CR>
nnoremap gri :action GotoImplementation<CR>
nnoremap gh :action ShowHoverInfo<CR>
nnoremap gra :action ShowIntentionActions<CR>
nnoremap grn :action RenameElement<CR>
" Line Helpers
nnoremap go o<Esc>
nnoremap gO O<Esc>
" Code Actions
nnoremap g. :action ShowIntentionActions<CR>
nnoremap gh :action QuickJavaDoc<CR>
nnoremap K :action QuickJavaDoc<CR>

" --- SCROLLING & APPEARANCE (z commands) ---
nnoremap zt :action EditorScrollToTop<CR>
nnoremap zz :action EditorScrollToCenter<CR>
nnoremap zb :action EditorScrollToBottom<CR>
" Folding
nnoremap za :action ExpandAllRegions<CR>
nnoremap zc :action CollapseRegion<CR>
nnoremap zC :action CollapseAllRegions<CR>
nnoremap zo :action ExpandRegion<CR>
nnoremap zO :action ExpandAllRegions<CR>
nnoremap z1 :action ExpandAllRegions<CR>
nnoremap z2 :action ExpandRegion<CR>
nnoremap z3 :action CollapseRegion<CR>

" --- DIAGNOSTICS & GIT (brackets [ / ] and d commands) ---
nnoremap ]d :action GotoNextError<CR>
nnoremap [d :action GotoPrevError<CR>
nnoremap ]c :action Vcs.ShowNextChangeMarker<CR>
nnoremap [c :action Vcs.ShowPrevChangeMarker<CR>
nnoremap ]m :action MethodDown<CR>
nnoremap [m :action MethodUp<CR>
" Git Actions
nnoremap do :action Vcs.ShowTabbedDiff<CR>
nnoremap dp :action Vcs.RollbackChangedLines<CR>

" --- SEARCH ---
nnoremap * :action FindNext<CR>
nnoremap # :action FindPrev<CR>
