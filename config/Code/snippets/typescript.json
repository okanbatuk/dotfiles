{
	// Place your snippets for typescript here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"abstract.class": {
		"body": "abstract class ${1:name} {\n\t$0\n};",
		"description": "create an abstract class.",
		"prefix": "_abs"
	},
	"arrow function": {
		"body": "${1:name} = ():${4:type} => {\n\t${0}\n};",
		"description": "Arrow function defining.",
		"prefix": "_arr"
	},
	"arrow function with param": {
		"body": "${1:name} = (${2:params}:${3:type}):${4:type} => {\n\t${0}\n};",
		"description": "Arrow function defining with param.",
		"prefix": "_arrpar"
	},
	"console.log": {
		"body": "console.log($0);",
		"description": "displays the specified in the console.",
		"prefix": "_clg"
	},
	"create interface": {
		"body": "interface ${1:name} {\n\t$0\n}",
		"description": "creates interface block.",
		"prefix": "_int"
	},
	"define ctor with members": {
		"body": "${1:modifier} ${2:name}: ${3:type}\n\npublic constructor(_${2:name}: ${3:type}) {\n\tthis.${2:name} = _${2:name};$0\n}",
		"description": "create a public constructor.",
		"prefix": "_memctor"
	},
	"define ctor with parameter": {
		"body": "${4:private} constructor(${1:private} ${2:name}: ${3:type}) {}",
		"description": "create a public constructor.",
		"prefix": "_paramctor"
	},
	"exports": {
		"body": "export default class ${1:childName} {\n\t${0}\n}",
		"description": "Define exports.",
		"prefix": "_exp"
	},
	"exports with implements": {
		"body": "export default class ${2:childName} implements ${1:parentName} {\n\t${0}\n}",
		"description": "Define exports with implements.",
		"prefix": "_expimp"
	},
	"for in loop": {
		"body": "for (let ${1:key} in ${2:object}) {\n\t${0}\n};",
		"description": "For in loop defining.",
		"prefix": "_forin"
	},
	"for of loop": {
		"body": "for (let ${1:element} of ${2:iterable}) {\n\t${0}\n};",
		"description": "For of loop defining.",
		"prefix": "_forof"
	},
	"import from": {
		"body": "import ${2:name} from ${1:module};\n${0}",
		"description": "Define import statement.",
		"prefix": "_imp"
	},
	"Prop getter": {
		"body": "get ${1:name}(): ${2:type} {\n\treturn this.${3:prop};\n}${0}",
		"description": "Define Get method as prop in class.",
		"prefix": "_getter"
	},
	"Prop setter": {
		"body": "set ${1:name}(${2:param}: ${3:type}) {\n\tthis.${4:prop} = ${2:param};\n}${0}",
		"description": "Define Set method as prop in class.",
		"prefix": "_setter"
	}
}