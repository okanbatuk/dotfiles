{
	// Place your snippets for javascriptreact here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"_arrowFunction": {
		"prefix": "_afd",
		"body": [
			"const ${1:name} = (${2:params}) => {",
			"  ${0}",
			"}"
		],
		"description": "_arrowFunctionDeclaration"
	},
	"_reactArrowFunctionComponent": {
		"prefix": "_rafc",
		"body": [
			"import React from 'react';",
			"",
			"const ${TM_FILENAME_BASE} = () => {",
			"  return (",
			"    <div>",
			"",
			"    </div>",
			"  )",
			"};",
			"",
			"export default ${TM_FILENAME_BASE};"
		],
		"description": "_reactArrowFunctionComponent"
	},
	"_reactArrowFunctionExportComponent": {
		"prefix": "_rafce",
		"body": [
			"import React from 'react';",
			"",
			"export default () => {",
			"  return (",
			"    <div>",
			"    </div>",
			"  )",
			"};",
			"",
		],
		"description": "_reactArrowFunctionExportComponent"
	},
	"_useEffect": {
		"prefix": "_eff",
		"body": [
			"useEffect(() => {",
			"  ${0}",
			"}, [${1:dep}])",
			""
		],
		"description": "_useEffect"
	},
	"_useState": {
		"prefix": "_uss",
		"body": [
			"const [${1:name}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:data});${0}",
		],
		"description": "_useState"
	}
}