# Basic Settings
set selection-clipboard clipboard
set adjust-open "best-fit"
set recolor "false"

# Window Size Settings
set window-width 1200
set window-height 1000

# Light / Clean Colors
set completion-bg           "#ffffff"
set completion-fg           "#000000"
set statusbar-bg            "#f1f1f1"
set statusbar-fg            "#000000"
set notification-bg         "#ffffff"
set notification-fg         "#000000"
set inputbar-bg             "#ffffff"
set inputbar-fg             "#000000"

# Search and Highlight Colors
set highlight-color         "#ffff00"
set highlight-active-color  "#ffcc00"

# Smooth Scrolling
set scroll-step 50
