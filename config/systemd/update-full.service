[Unit]
Description=Weekly Full System Update
After=network-online.target
Wants=network-online.target
Conflicts=update-light.service

[Service]
Type=oneshot
TimeoutStartSec=10m
User=root
WorkingDirectory=/home/myrn
Environment=REAL_USER=myrn
Environment=HOME=/home/myrn
Environment=DOTFILES_DIR=/home/myrn/dotfiles
Environment=PATH=/home/myrn/.local/share/fnm:/home/myrn/.local/share/pnpm/bin:/home/myrn/.bun/bin:/home/myrn/.cargo/bin:/home/myrn/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/myrn/scripts/.update.sh --full
